# StudyFlow backend configuration.
# Copy to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env

# Anthropic API key for the AI study assistant.
# Get one at https://console.anthropic.com/settings/keys
# If unset, the backend still boots but the assistant falls back to canned replies.
ANTHROPIC_API_KEY=sk-ant-...

# Secret used to sign JWT access tokens. Must be long and random.
# Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Leaving this unset falls back to a public, insecure default: the backend logs a
# warning in development and refuses to start when ENVIRONMENT=production.
JWT_SECRET_KEY=

# Comma-separated list of browser origins allowed to call this API (CORS).
# Include the scheme and no trailing slash. Defaults to the local Next.js dev server.
# Production example: https://studyflow.vercel.app,https://www.studyflow.app
FRONTEND_ORIGINS=http://localhost:3000

# Set to "production" on your deployed instance to turn the weak-secret warning
# into a hard startup failure. Anything else (or unset) is treated as development.
ENVIRONMENT=development
