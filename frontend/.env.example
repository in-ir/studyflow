# StudyFlow frontend configuration.
# Copy to `.env.local` (which is gitignored) and adjust:
#     cp .env.example .env.local

# Base URL of the StudyFlow FastAPI backend, with no trailing slash.
# NEXT_PUBLIC_ prefix is required: this value is inlined into the browser bundle
# at build time, so it must be set in your host's build environment (e.g. Vercel
# project settings), not just at runtime.
# Local default if unset: http://localhost:8000
# Production example: https://studyflow-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
